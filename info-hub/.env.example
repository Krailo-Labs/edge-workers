# InfoHub Environment Variables
# These variables should be configured in your Cloudflare Pages dashboard

# AI Platform Integration
GEMINI_API_KEY=

# Example: API keys or secrets (currently app uses local storage / mock DB)
# CF_PAGES=1

# === CLOUDFLARE AI WORKERS CONFIGURATION ===
# Базовий URL до вашого Cloudflare Worker (наприклад: https://ai-router.krailo.sh)
NEXT_PUBLIC_CF_WORKER_URL=

# Токен доступу до Worker (якщо налаштовано автентифікацію)
NEXT_PUBLIC_CF_WORKER_AUTH_TOKEN=

# === CLOUDFLARE D1 (DATABASE) CONFIGURATION ===
NEXT_PUBLIC_CF_D1_DATABASE_ID=
NEXT_PUBLIC_CF_ACCOUNT_ID=
NEXT_PUBLIC_CF_API_TOKEN=
